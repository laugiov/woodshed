{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woodshed:song:1",
  "title": "woodshed song",
  "description": "Analysis of one recording, as consumed by the practice page. Times are in seconds from the start of the file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "file", "duration", "bpm", "beats_per_bar", "key", "key_regions", "capo", "beats", "first_beat",
               "music_start", "music_end", "bars", "groups", "sections", "harmony", "energy", "parts", "analysis",
               "meta"],
  "$defs": {
    "pc": {"type": "integer", "minimum": 0, "maximum": 11},
    "quality": {"type": "string", "enum": ["", "m", "7", "m7", "N"]},
    "shares16": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "chord": {
      "type": "object", "additionalProperties": false, "required": ["pc", "quality", "beats", "doubt"],
      "properties": {
        "pc": {"type": "integer", "minimum": -1, "maximum": 11},
        "quality": {"$ref": "#/$defs/quality"},
        "beats": {"type": "integer", "minimum": 1},
        "doubt": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["id", "why", "kind", "alternatives"],
             "properties": {
               "id": {"type": "integer", "minimum": 0},
               "why": {"type": "string"},
               "kind": {"enum": ["chord", "timing"]},
               "alternatives": {"type": "array", "items": {
                 "type": "object", "additionalProperties": false, "required": ["pc", "quality", "share"],
                 "properties": {"pc": {"$ref": "#/$defs/pc"}, "quality": {"$ref": "#/$defs/quality"},
                                "share": {"type": "integer", "minimum": 0, "maximum": 100}}}}}}
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": 3},
    "title": {"type": "string"},
    "file": {"type": "string"},
    "duration": {"type": "number", "minimum": 0},
    "bpm": {"type": "number", "exclusiveMinimum": 0},
    "beats_per_bar": {"type": "integer", "minimum": 2, "maximum": 12},
    "key": {"type": "object", "additionalProperties": false, "required": ["pc", "mode", "known"],
            "properties": {"pc": {"$ref": "#/$defs/pc"}, "mode": {"enum": ["maj", "min"]}, "known": {"type": "boolean"}}},
    "key_regions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["bar", "pc", "mode"],
      "properties": {"bar": {"type": "integer", "minimum": 0}, "pc": {"$ref": "#/$defs/pc"}, "mode": {"enum": ["maj", "min"]}}}},
    "capo": {"type": "integer", "minimum": 0, "maximum": 7},
    "beats": {"type": "array", "items": {"type": "number"}},
    "first_beat": {"type": "integer"},
    "music_start": {"type": ["number", "null"]},
    "music_end": {"type": ["number", "null"]},
    "bars": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "group", "occurrence", "column", "chords"],
      "properties": {"start": {"type": "number"}, "end": {"type": "number"},
                     "group": {"type": "integer", "minimum": 0}, "occurrence": {"type": "integer", "minimum": 0},
                     "column": {"type": "integer", "minimum": 0},
                     "chords": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chord"}}}}},
    "sections": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "role", "letter", "start", "end"],
      "properties": {"name": {"type": "string"},
                     "role": {"enum": ["intro", "verse", "prechorus", "chorus", "bridge", "instrumental", "outro",
                                       "part"]},
                     "letter": {"type": "string", "pattern": "^[A-Z][0-9]*$"},
                     "start": {"type": "integer", "minimum": 0},
                     "end": {"type": "integer", "minimum": 1}}}},
    "groups": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["label", "family", "occurrences"],
      "properties": {"label": {"type": "string"}, "family": {"type": "string", "pattern": "^[A-Z]+$"},
                     "occurrences": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}}}}},
    "harmony": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["label", "chords", "romans", "name"],
      "properties": {"label": {"type": "string"},
                     "chords": {"type": "array", "items": {"type": "array", "prefixItems": [{"$ref": "#/$defs/pc"}, {"$ref": "#/$defs/quality"}], "minItems": 2, "maxItems": 2}},
                     "romans": {"type": "array", "items": {"type": "string"}},
                     "name": {"type": ["string", "null"]}}}},
    "energy": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
    "parts": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["groove", "bass", "comp", "voicings", "vocal", "grid_shift"],
         "properties": {
           "groove": {"oneOf": [{"type": "null"},
             {"type": "object", "additionalProperties": false, "required": ["kick", "snare", "hat", "agreement", "bars"],
              "properties": {"kick": {"$ref": "#/$defs/shares16"}, "snare": {"$ref": "#/$defs/shares16"}, "hat": {"$ref": "#/$defs/shares16"},
                             "agreement": {"type": "object", "additionalProperties": {"type": "number"}},
                             "bars": {"type": "integer", "minimum": 0}}}]},
           "bass": {"type": "array", "items": {"type": "array", "items": {"oneOf": [{"type": "null"},
             {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 127}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2}]}}},
           "comp": {"$ref": "#/$defs/shares16"},
           "voicings": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/pc"}, "maxItems": 4}},
           "vocal": {"oneOf": [{"type": "null"},
             {"type": "object", "additionalProperties": false, "required": ["low", "high", "voiced_share"],
              "properties": {"low": {"type": "integer"}, "high": {"type": "integer"}, "voiced_share": {"type": "number"}}}]},
           "grid_shift": {"type": "number"}}}
      ]
    },
    "analysis": {"type": "object", "additionalProperties": false, "required": ["beats", "tempo_halved", "stems", "sevenths", "clarity", "chords_reliable", "stems_gain", "bpm_hint"],
                 "properties": {"beats": {"enum": ["librosa", "beat_this"]}, "tempo_halved": {"type": "boolean"},
                                "stems": {"type": "boolean"}, "sevenths": {"type": "boolean"},
                                "clarity": {"type": "number", "minimum": 0, "maximum": 1}, "chords_reliable": {"type": "boolean"},
                                "stems_gain": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
                                "bpm_hint": {"type": ["number", "null"], "exclusiveMinimum": 0}}},
    "meta": {"description": "How this file was made. Not part of the analysis result: it differs between two runs on the same input.",
             "type": "object", "additionalProperties": false, "required": ["version", "seconds"],
             "properties": {"version": {"type": "string"}, "seconds": {"type": "number", "minimum": 0}}}
  }
}
