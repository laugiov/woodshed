{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woodshed:view:1",
  "title": "woodshed page view tables",
  "description": "Names and tables the page displays, computed by woodshed.theory so that the page holds no music theory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["view_version", "transpositions", "romans", "shapes", "tracks", "pending", "exports"],
  "$defs": {
    "twelve_strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 12, "maxItems": 12},
    "frets": {"type": "array", "items": {"type": "integer", "minimum": -1, "maximum": 24}, "minItems": 6, "maxItems": 6}
  },
  "properties": {
    "view_version": {"const": 1},
    "transpositions": {"type": "array", "minItems": 12, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["key", "roots", "capo"],
      "properties": {"key": {"type": "string"}, "roots": {"$ref": "#/$defs/twelve_strings"},
                     "capo": {"type": "integer", "minimum": 0, "maximum": 7}}}},
    "romans": {"type": "object", "additionalProperties": false, "required": ["", "m", "7", "m7"],
               "properties": {"": {"$ref": "#/$defs/twelve_strings"}, "m": {"$ref": "#/$defs/twelve_strings"},
                              "7": {"$ref": "#/$defs/twelve_strings"}, "m7": {"$ref": "#/$defs/twelve_strings"}}},
    "shapes": {"type": "object", "additionalProperties": false, "required": ["open", "easy_barres"],
               "properties": {"open": {"type": "object", "additionalProperties": {"$ref": "#/$defs/frets"}},
                              "easy_barres": {"type": "object", "additionalProperties": {"$ref": "#/$defs/frets"}}}},
    "pending": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["eta_seconds"],
                "properties": {"eta_seconds": {"type": "integer", "minimum": 1}}}]},
    "exports": {"type": "array", "items": {"type": "string", "pattern": "^exports/[^/]+\\.(cho|lab|json|mid|musicxml)$"}},
    "tracks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "file"],
      "properties": {"id": {"type": "string", "pattern": "^(mix|minus-[a-z]+|solo-[a-z]+)$"},
                     "label": {"type": "string"}, "file": {"type": "string", "pattern": "^audio/[a-z-]+\\.flac$"}}}}
  }
}
